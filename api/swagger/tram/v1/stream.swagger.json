{
  "swagger": "2.0",
  "info": {
    "title": "tram/v1/stream.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "StreamService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/streams": {
      "get": {
        "operationId": "StreamService_ListStreams",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListStreamsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "tags": [
          "StreamService"
        ]
      }
    },
    "/v1/streams/{name}": {
      "get": {
        "operationId": "StreamService_GetStream",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetStreamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "StreamService"
        ]
      },
      "delete": {
        "operationId": "StreamService_DeleteStream",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteStreamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "StreamService"
        ]
      }
    },
    "/v1/streams/{stream.name}": {
      "put": {
        "operationId": "StreamService_PutStream",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PutStreamResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "stream.name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StreamServicePutStreamBody"
            }
          }
        ],
        "tags": [
          "StreamService"
        ]
      }
    }
  },
  "definitions": {
    "StreamServicePutStreamBody": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "#/definitions/v1Source"
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "$ref": "#/definitions/v1Stage"
              }
            },
            "sinks": {
              "type": "array",
              "items": {
                "type": "object",
                "$ref": "#/definitions/v1Sink"
              }
            },
            "metrics": {
              "$ref": "#/definitions/v1Metrics"
            },
            "suspended": {
              "type": "boolean",
              "description": "When true, the stream is defined but its source does not run: no ports\nare opened and no consumers are attached. Used to pause a stream, e.g.\nthe writer of a buffer while its queue is drained."
            }
          }
        },
        "dryRun": {
          "type": "boolean",
          "description": "When true, the stream is validated and planned but not applied; the\nresponse holds the plan instead of changing the running stream."
        }
      }
    },
    "googlerpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "v1DeleteStreamResponse": {
      "type": "object"
    },
    "v1GetStreamResponse": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "#/definitions/v1Stream"
        }
      }
    },
    "v1ListStreamsResponse": {
      "type": "object",
      "properties": {
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Stream"
          },
          "description": "All streams, ordered by name."
        }
      }
    },
    "v1Metrics": {
      "type": "object",
      "properties": {
        "records": {
          "$ref": "#/definitions/v1NodeMetrics",
          "description": "tram.node.records and tram.node.records.out."
        },
        "duration": {
          "$ref": "#/definitions/v1NodeMetrics",
          "description": "tram.node.duration."
        },
        "requestSize": {
          "type": "boolean",
          "description": "tram.source.request.size. Defaults to true."
        }
      },
      "description": "Chooses the metrics a stream records. Unset fields keep their defaults."
    },
    "v1NodeMetrics": {
      "type": "object",
      "properties": {
        "source": {
          "type": "boolean",
          "description": "Defaults to true."
        },
        "stages": {
          "type": "boolean",
          "description": "Defaults to false."
        },
        "sinks": {
          "type": "boolean",
          "description": "Defaults to true."
        }
      },
      "description": "Enables a metric per kind of node. Unset fields keep their defaults."
    },
    "v1PutStreamResponse": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "#/definitions/v1Stream"
        },
        "plan": {
          "$ref": "#/definitions/v1StreamPlan",
          "description": "Set when the request's dry_run is true."
        }
      }
    },
    "v1Sink": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "v1Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "v1Stage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "v1Stream": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/v1Source"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Stage"
          }
        },
        "sinks": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Sink"
          }
        },
        "metrics": {
          "$ref": "#/definitions/v1Metrics"
        },
        "suspended": {
          "type": "boolean",
          "description": "When true, the stream is defined but its source does not run: no ports\nare opened and no consumers are attached. Used to pause a stream, e.g.\nthe writer of a buffer while its queue is drained."
        }
      }
    },
    "v1StreamPlan": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/definitions/v1StreamPlanAction"
        },
        "sourceReplaced": {
          "type": "boolean",
          "description": "True when the source would be replaced, i.e. the action is REBUILD and\nthe stream already existed with another source."
        },
        "createdNodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stages and sinks that would be created, by name."
        },
        "stoppedNodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stages and sinks that would be stopped, by name."
        }
      },
      "description": "The plan of an upsert, computed by a dry run. Node names are unique within\na stream."
    },
    "v1StreamPlanAction": {
      "type": "string",
      "enum": [
        "STREAM_PLAN_ACTION_UNSPECIFIED",
        "STREAM_PLAN_ACTION_NOOP",
        "STREAM_PLAN_ACTION_HOT_SWAP",
        "STREAM_PLAN_ACTION_REBUILD"
      ],
      "default": "STREAM_PLAN_ACTION_UNSPECIFIED",
      "description": "What an upsert of a stream would do, without applying it.\n\n - STREAM_PLAN_ACTION_NOOP: The stream is unchanged, nothing would happen.\n - STREAM_PLAN_ACTION_HOT_SWAP: The source is unchanged and keeps running; its stages and sinks are\nreplaced below it (\"hot swap\").\n - STREAM_PLAN_ACTION_REBUILD: The stream is new, stopped, or its source changed: it is stopped and\nrebuilt completely."
    }
  }
}
